{
  "_comment": "Column classification for every table in migrations.json (issue #29). Every column must appear here; tests/test_data_classification.py fails on any unclassified or stale column. Retention rules are proposals for owner confirmation, as in docs/privacy-data-classification.md.",
  "classes": {
    "public": {
      "meaning": "Club, team, season, venue access details and results that the club publishes to its members.",
      "retention": "Kept with the season or club. Removed when the club is deleted."
    },
    "personal": {
      "meaning": "Identifies a person or what they did: names, memberships, roster states, free text that may name someone, and identifiers of people.",
      "retention": "While the person is on the team for the season. Then the person-linked rows are removed 12 months after the season ends, and the fixture and its public result are kept. Removed sooner on request."
    },
    "contact": {
      "meaning": "A way to reach a person or a venue contact.",
      "retention": "While the contact is current. Removed when the membership ends, when the contact is replaced, or on request."
    },
    "activity": {
      "meaning": "Audit and history records: who changed what, and when.",
      "retention": "2 years from the change, proposed. Personal identifiers in these rows are removed at that point; the action and counts are kept."
    },
    "scorecard": {
      "meaning": "Scorecard file references and the uploader of a scorecard. The files are R2 objects, out of scope for the archive.",
      "retention": "12 months after the season ends, or sooner on request. The record keeps its status."
    },
    "document": {
      "meaning": "Stored library document files (R2).",
      "retention": "Until the document expires (expires_on), and 12 months after the season, whichever is earlier."
    },
    "secret": {
      "meaning": "Credentials such as invitation tokens.",
      "retention": "Cleared when the invitation is claimed, and at the latest 7 days after it is issued."
    },
    "technical": {
      "meaning": "Identifiers, timestamps, counts, enumerated states and hashes that carry no personal information on their own.",
      "retention": "Kept with the record they belong to."
    },
    "junior": {
      "meaning": "Reserved. Data about a person under 18. None is stored. Retention must be defined before any such column is added.",
      "retention": "Not applicable until a column is added; the rule must be written first."
    },
    "location": {
      "meaning": "Reserved. A person’s or a venue’s location beyond a public address. None is stored; only consent-gated use is allowed.",
      "retention": "Not applicable until a column is added; only with recorded consent (see web/src/location/consent.ts)."
    }
  },
